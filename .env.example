# =============================================================================
#  Kanchi Vastra — environment settings template
# -----------------------------------------------------------------------------
#  Copy to .env.local for local development and fill in real values.
#  .env.local is git-ignored: real values must NEVER be committed.
#
#  On the server the same keys live in /srv/kanchi-vastra/shared/app.env.
#  Every key is validated at runtime by src/config/env.server.ts (secrets) or
#  src/config/env.public.ts (NEXT_PUBLIC_*), which name any missing key.
#
#  NEXT_PUBLIC_* values are copied into the browser bundle — never put a
#  secret in one.
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- CMS (Sanity) — public identifiers, safe in the browser -------------------
# Leave the project id empty to serve the built-in demo catalogue.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared with the Sanity webhook; 32+ random characters (openssl rand -hex 32).
SANITY_REVALIDATE_SECRET=

# --- Database (PostgreSQL) -------------------------------------------------------
# Server: postgresql://kanchi:<password>@postgres:5432/kanchi_vastra
DATABASE_URL=

# --- Photo storage (S3-compatible; Garage on the server) --------------------------
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=kanchi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=https://your-site/media

# --- Email (SMTP) ----------------------------------------------------------------
# DEV: Mailpit catches everything (host mailpit, port 1025, no login).
# PROD: Stalwart on your domain (port 465, SMTP_SECURE=true, with login).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kanchi Vastra <hello@your-domain>"

# --- Payments (Razorpay) — not enabled yet ---------------------------------------
# The key id is public; the secrets are server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
