# ---------------------------------------------------------------------------
# Database - PostgreSQL (Neon). Real values live in .env, which is git-ignored.
# DATABASE_URL is the POOLED endpoint, used by the running app.
# DIRECT_URL is the UNPOOLED endpoint, used by migrations (DDL through a
# pooler is unreliable because statements may land on different sessions).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host/db?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Sri Kanchi Silks - environment variables
# Copy to `.env.local` for local development. NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# Public site URL - used for canonical URLs, sitemap, Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (NOT yet enabled - see README "Future integrations") ----------
# The key id is public and may be exposed to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# The key secret is SERVER-ONLY. Never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=
# Webhook signature secret, used to verify Razorpay webhook payloads server-side.
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional email (not yet wired) -----------------------------------
CONTACT_FORM_TO_EMAIL=
RESEND_API_KEY=

# --- Analytics (not yet wired) ---------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Photo storage (S3-compatible). DEV: Garage on the server. ---------------
S3_ENDPOINT="http://127.0.0.1:3900"
S3_REGION="garage"
S3_BUCKET="kanchi-media"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL="https://your-site/media"

# --- Email. DEV: Mailpit (catches everything). PROD: your Hostinger mailbox. --
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kanchi Vastra <hello@your-domain>"
