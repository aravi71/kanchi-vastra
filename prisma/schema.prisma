// ===========================================================================
//  Kanchi Vastra — database schema
//  PostgreSQL (Neon) + Prisma. Single source of truth for the storefront and
//  the admin panel.
//
//  Money is Decimal(10,2), never Float — binary floating point cannot
//  represent 18500.10 exactly and rounding errors in an order total are
//  unacceptable.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
//  People
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      DateTime?
  name               String?
  phone              String?
  // scrypt hash ("scrypt$N$r$p$salt$hash") — never a plain password.
  passwordHash       String?
  role               Role      @default(CUSTOMER)
  image              String?
  // Disabled accounts cannot sign in; their sessions are revoked.
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  // TOTP secret, AES-256-GCM encrypted with APP_ENCRYPTION_KEY. Required
  // for STAFF and ADMIN before they can use the admin panel.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  addresses Address[]
  orders    Order[]
  cart      Cart?
  wishlist  Wishlist?
  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// --- Auth.js adapter tables ------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum SessionScope {
  CUSTOMER
  ADMIN
}

model Session {
  id              String       @id @default(cuid())
  // SHA-256 of the cookie value; the cookie itself is never stored.
  sessionToken    String       @unique
  userId          String
  expires         DateTime
  scope           SessionScope @default(CUSTOMER)
  // Admin sessions are unusable until the authenticator code is entered.
  twoFactorPassed Boolean      @default(false)
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime     @default(now())
  lastUsedAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// Every sign-in attempt, for brute-force limits and the security log.
model LoginAttempt {
  id        String       @id @default(cuid())
  email     String
  ip        String
  scope     SessionScope
  success   Boolean
  createdAt DateTime     @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Who changed what in the admin panel.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String
  action     String
  entity     String
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String? // "Home", "Office"
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
//  Catalogue
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  // Self-relation so categories can nest later without a migration.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products           Product[]
  collectionProducts Product[] @relation("ProductCollections")

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?       @db.Text
  shortDescription String?
  // Base price. A variant may override it.
  price            Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)
  sku              String        @unique
  status           ProductStatus @default(DRAFT)

  // Primary category - drives breadcrumbs, canonical URL and SEO.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Additional collections this saree is merchandised in. A bridal piece
  // that is also a Kanchipuram weave belongs in both listings.
  collections Category[] @relation("ProductCollections")

  images   ProductImage[]
  variants ProductVariant[]

  // Merchandising flags the storefront already uses.
  isFeatured   Boolean @default(false)
  isNewArrival Boolean @default(false)
  sortOrder    Int     @default(0)

  // Saree-specific detail, kept as a JSON blob because it is descriptive text
  // shown on the page and never filtered or joined on.
  specs Json?

  // Filter facets — indexed because the shop filters on them.
  colorName   String?
  colorHex    String?
  colorFamily String?
  fabric      String?

  // SEO
  metaTitle       String?
  metaDescription String?

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([colorFamily])
  @@index([fabric])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  // The image lives in object storage, never in Postgres.
  url        String
  // Provider-side id (Sanity asset id, Cloudinary public_id, S3 key) so the
  // original can be deleted or re-transformed later.
  providerId String?
  provider   String  @default("storage")
  alt        String?
  sortOrder  Int     @default(0)
  width      Int?
  height     Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// A variant is a specific buyable thing: this saree, in this colourway.
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String   @unique
  // Null means "same as the parent product".
  price          Decimal? @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  imageUrl       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Flexible attributes: size, colour, border type, blouse length — any
  // name/value pair, so a new attribute never needs a migration.
  options   VariantOption[]
  inventory Inventory?

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model VariantOption {
  id        String @id @default(cuid())
  variantId String
  name      String // "Size", "Border"
  value     String // "6.3 m", "Korvai"

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // One value per attribute name per variant.
  @@unique([variantId, name])
  @@index([name, value])
}

// Stock lives apart from Product so it can be updated atomically and often
// without rewriting the product row.
model Inventory {
  id                String @id @default(cuid())
  variantId         String @unique
  quantity          Int    @default(0)
  // Held by carts mid-checkout; available = quantity - reserved.
  reserved          Int    @default(0)
  lowStockThreshold Int    @default(2)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
//  Cart & wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String  @id @default(cuid())
  // Exactly one of these is set: a signed-in shopper, or a guest cookie.
  userId    String? @unique
  sessionId String? @unique

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Adding the same thing twice bumps quantity instead of making a second row.
  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  createdAt DateTime @default(now())
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ---------------------------------------------------------------------------
//  Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  // Human-readable, shown to the customer: KV-2026-0001
  orderNumber   String        @unique
  userId        String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Every figure below is computed on the server from the database.
  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  shippingAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  couponId   String?
  couponCode String? // snapshot: the coupon may be edited or deleted later

  shippingAddressId String?
  billingAddressId  String?

  // Contact details captured at checkout, so a guest order is still complete
  // and a later edit to the user's profile cannot rewrite history.
  email String
  phone String

  paymentProvider  String? // "razorpay"
  paymentReference String? // gateway order/payment id
  notes            String? @db.Text

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

// Deliberately denormalised: an order line records what was bought at the
// price it was bought for. Editing a product later must never alter an
// order that has already been placed.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  productName String
  variantName String?
  sku         String
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
//  Promotions & content
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2) // caps a percentage discount
  usageLimit    Int? // total uses allowed
  usageCount    Int          @default(0)
  perUserLimit  Int?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, endsAt])
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  position       String    @default("home_hero")
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, isActive, sortOrder])
}

// Key/value store for shop settings the admin can edit (shipping thresholds,
// contact details) without a deploy.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
